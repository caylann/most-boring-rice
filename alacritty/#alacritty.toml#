general.import = ["~/.cache/wal/colors-alacritty.toml"]

[env]
WINIT_X11_SCALE_FACTOR = "1.3"

[font]
size = 13

[font.normal]
family = "Terminess Nerd Font"
style = "Bold"

[font.bold]
family = "Terminess Nerd Font"
style = "Bold"

[font.italic]
family = "Terminess Nerd Font"
style = "Italic"

[font.bold_italic]
family = "Terminess Nerd Font"
style = "Bold Italic"

[window.padding]
x = 5
y = 7

[font.offset]
x = 0
y = -4

## Default colors
#[colors.primary]
#background = '#ffffff'
#foreground = '#000000'
#
#[colors.cursor]
#cursor = '#000000'
#text = '#ffffff'
